{
  "expo": {
    "name": "AccessAI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow AccessAI to turn what's said in a conversation, and your voice commands to Accel, into text.",
        "NSMicrophoneUsageDescription": "Allow AccessAI to use the microphone to turn what's said in a conversation, and your voice commands to Accel, into text."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5362C8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.aeno.frontend"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5362C8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AccessAI to use your location so it can be included when you send an SOS alert."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AccessAI to use the camera to scan a friend's QR code and to recognize sign language.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5362C8",
          "defaultChannel": "chat_messages"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AccessAI to use the microphone to turn what's said in a conversation, and your voice commands to Accel, into text.",
          "speechRecognitionPermission": "Allow AccessAI to turn what's said in a conversation, and your voice commands to Accel, into text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf7458b4-17c3-4fb7-91cd-295b867dd7a5"
      }
    }
  }
}
