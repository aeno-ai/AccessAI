# backend/.env ON THE SERVER (HANDOFF.md §53). Copy this to backend/.env on
# the server and fill it in. Never commit the real file.
# Values marked "same as the laptop" are copied from your laptop's backend/.env.

# --- Database (same as the laptop) ---
MONGO_URI=
DB_USERNAME=
DB_PASSWORD=

# --- Login secrets (same as the laptop, so existing logins keep working) ---
JWT_SECRET=
ADMIN_JWT_SECRET=

# --- Email codes through Gmail (same as the laptop) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Google sign-in (same as the laptop) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NEW on the server ---
# Production mode: the admin cookie is HTTPS-only.
NODE_ENV=production
PORT=3000
# Your address (no slash at the end). Google sign-in returns here.
BACKEND_PUBLIC_URL=https://YOUR-NAME.duckdns.org
# Browsers allowed to call the API: the admin site (same address).
ALLOWED_ORIGINS=https://YOUR-NAME.duckdns.org
# How many backend copies (one per CPU core: 4 on the Always Free VM).
CLUSTER_WORKERS=4
# Caddy runs on this same machine, so the default proxy trust is right.
# TRUST_PROXY=loopback
